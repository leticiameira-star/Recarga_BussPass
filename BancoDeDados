

CREATE DATABASE IF NOT EXISTS transporte_publico;
USE transporte_publico;

CREATE TABLE usuario (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    sobrenome VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    telefone varchar(11) NOT NULL,
    cpf varchar(11) NOT NULL UNIQUE,
    senha VARCHAR(30) NOT NULL
);

CREATE TABLE cartao (
    id_cartao INT AUTO_INCREMENT PRIMARY KEY, 
    id_usuario INT,                    
    tipo VARCHAR(50) NOT NULL,
    saldo DECIMAL(10,2) DEFAULT 0,
    FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario)
);

CREATE TABLE coordenada (
    id_coordenada INT AUTO_INCREMENT PRIMARY KEY,
    latitude DECIMAL(10,8) NOT NULL,
    longitude DECIMAL(11,8) NOT NULL,
    data_hora DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE linha (
    id_linha INT AUTO_INCREMENT PRIMARY KEY,
    inicio VARCHAR(100) NOT NULL,
    final VARCHAR(100) NOT NULL,
    nome_linha VARCHAR(100) NOT NULL
);


CREATE TABLE recarga (
    id_recarga INT AUTO_INCREMENT PRIMARY KEY,
    id_cartao INT,                          
    transacao VARCHAR(100) NOT NULL,
    valor DECIMAL(10,2) NOT NULL,
    horario DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_cartao) REFERENCES cartao(id_cartao)
);

CREATE TABLE historico (
    id_historico INT AUTO_INCREMENT PRIMARY KEY, 
    id_cartao INT,                             
    id_recarga INT,                              
    horario DATETIME DEFAULT CURRENT_TIMESTAMP,
    descricao VARCHAR(255) NOT NULL,
    FOREIGN KEY (id_cartao) REFERENCES cartao(id_cartao),
    FOREIGN KEY (id_recarga) REFERENCES recarga(id_recarga)
);

CREATE TABLE notificacao (
    id_notificacao INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT,                                
    mensagem VARCHAR(255) NOT NULL,
    lida BOOLEAN DEFAULT FALSE,
    data DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario)
);
