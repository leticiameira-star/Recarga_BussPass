#include <MCUFRIEND_kbv.h>
#include <Adafruit_GFX.h>
#include <Stepper.h>
MCUFRIEND_kbv tft;
// Motor 28BYJ-48 + ULN2003
#define M_IN1 31
#define M_IN2 33
#define M_IN3 35
#define M_IN4 37
const int PASSOS_VOLTA = 2048;
// A biblioteca Stepper precisa da ordem IN1, IN3, IN2, IN4
Stepper motor(PASSOS_VOLTA, M_IN1, M_IN3, M_IN2, M_IN4);
// Quantos passos o motor gira por passageiro (512 = 1/4 de volta)
const int PASSOS_CATRACA = 512;
#define PRETO     0x0000
#define BRANCO    0xFFFF
#define VERDE     0x07E0
#define VERMELHO  0xF800
#define AMARELO   0xFFE0
// Valor da tarifa mostrado na tela inicial (em centavos)
const int TARIFA_CENTAVOS = 500;
String mensagem = "";
void mostrarDinheiro(int centavos) {
  tft.print("R$ ");
  tft.print(centavos / 100);
  tft.print(",");
  int resto = centavos % 100;
  if (resto < 10) tft.print("0");
  tft.print(resto);
}
void desligarMotor() {
  digitalWrite(M_IN1, LOW);
  digitalWrite(M_IN2, LOW);
  digitalWrite(M_IN3, LOW);
  digitalWrite(M_IN4, LOW);
}
// Gira apenas para um lado (use -PASSOS_CATRACA para inverter o sentido)
void liberarCatraca() {
  motor.setSpeed(10);
  motor.step(PASSOS_CATRACA);
  desligarMotor();
}
// TELA 1: aproxime o cartao + valor da tarifa
void telaInicial() {
  tft.fillScreen(PRETO);
  tft.setTextColor(BRANCO);
  tft.setTextSize(3);
  tft.setCursor(70, 40);
  tft.println("APROXIME");
  tft.setCursor(50, 80);
  tft.println("SEU CARTAO");
  tft.setTextColor(AMARELO);
  tft.setTextSize(2);
  tft.setCursor(20, 150);
  tft.println("Valor Tarifa:");
  tft.setTextSize(3);
  tft.setCursor(20, 180);
  mostrarDinheiro(TARIFA_CENTAVOS);
}
void telaErro() {
  tft.fillScreen(PRETO);
  tft.setTextColor(VERMELHO);
  tft.setTextSize(3);
  tft.setCursor(100, 50);
  tft.println("ERRO");
  tft.setTextColor(BRANCO);
  tft.setTextSize(2);
  tft.setCursor(20, 120);
  tft.println("Falha comunicacao");
  delay(3000);
  telaInicial();
}
void telaNegado() {
  tft.fillScreen(PRETO);
  tft.setTextColor(VERMELHO);
  tft.setTextSize(3);
  tft.setCursor(50, 70);
  tft.println("RECARREGUE");
  tft.setCursor(30, 110);
  tft.println("O SEU CARTAO");
  delay(3000);
  telaInicial();
}
// TELA 2: catraca liberada + saldo disponivel
void telaPagamento(int saldoAntes, int desconto, int saldoRestante) {
  tft.fillScreen(PRETO);
  tft.setTextColor(VERDE);
  tft.setTextSize(3);
  tft.setCursor(20, 40);
  tft.println("CATRACA");
  tft.setCursor(20, 80);
  tft.println("LIBERADA");
  tft.setTextColor(AMARELO);
  tft.setTextSize(2);
  tft.setCursor(20, 150);
  tft.println("Saldo Disponivel:");
  tft.setTextSize(3);
  tft.setCursor(20, 180);
  mostrarDinheiro(saldoRestante);
  liberarCatraca();   // gira o motor com a tela de liberada
  delay(3000);        // mantem a mensagem na tela
  telaInicial();
}
void processarMensagem(String texto) {
  texto.trim();
  Serial.print("PROCESSANDO: <"); Serial.print(texto); Serial.println(">");
  if (texto == "NEGADO") { telaNegado(); return; }
  if (texto == "ERRO")   { telaErro();   return; }
  int p1 = texto.indexOf("SALDO_ANTES:");
  int p2 = texto.indexOf(";DESCONTO:");
  int p3 = texto.indexOf(";SALDO_RESTANTE:");
  if (p1 >= 0 && p2 >= 0 && p3 >= 0) {
    String sAntes = texto.substring(p1 + 12, p2);
    String sDesc  = texto.substring(p2 + 10, p3);
    String sRest  = texto.substring(p3 + 16);
    telaPagamento(sAntes.toInt(), sDesc.toInt(), sRest.toInt());
  } else {
    Serial.println("Mensagem ignorada (formato incorreto).");
  }
}
void setup() {
  Serial.begin(115200);
  Serial1.begin(9600);
  uint16_t ID = tft.readID();
  tft.begin(ID);
  tft.setRotation(1);
  telaInicial();
  Serial.println("MEGA INICIADO - AGUARDANDO ESP32");
}
void loop() {
  while (Serial1.available() > 0) {
    char c = Serial1.read();
    if (c == '\n') {
      if (mensagem.length() > 0) processarMensagem(mensagem);
      mensagem = "";
    } else if (c >= 32 && c <= 126) {
      if (mensagem.length() < 100) mensagem += c;
    }
  }
}
